@{
    ViewData["Title"] = "Council Admin Portal";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-7 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="p-4 bg-dark text-white text-center">
                    <div class="brand-icon mx-auto mb-2 bg-warning text-dark"><i class="bi bi-shield-lock-fill fs-5"></i></div>
                    <h3 class="fw-bold mb-1 text-white">Council Admin</h3>
                    <p class="small text-white-50 mb-0">Municipal sports booking management & approvals</p>
                </div>
                <div class="card-body p-4 p-md-5 bg-white">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-4 shadow-sm mb-4"></div>
                    <form method="post" asp-controller="Admin" asp-action="Login">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Admin Email</label>
                            <input class="form-control form-control-lg" type="email" name="email" value="admin@sportscouncil.gov" required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label small fw-semibold text-muted">Password</label>
                            <input class="form-control form-control-lg" type="password" name="password" value="admin@123" required />
                        </div>
                        <button class="btn btn-brand btn-lg w-100 rounded-pill fw-bold shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In to Admin Portal
                        </button>
                    </form>
                    <div class="text-center mt-4 pt-3 border-top">
                        <span class="badge bg-light text-muted border p-2 small">
                            <i class="bi bi-info-circle me-1"></i> Demo: admin@sportscouncil.gov / admin@123
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>