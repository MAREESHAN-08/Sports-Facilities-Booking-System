@model List<Booking>
@{
    ViewData["Title"] = "Council Admin Dashboard";
    int pendingCount = Model.Count(b => b.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase));
    int confirmedCount = Model.Count(b => b.Status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase));
}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="kicker">MUNICIPAL COUNCIL MANAGEMENT</span>
            <h1 class="display-6 fw-bold mb-0">Booking Approvals & Dashboard</h1>
        </div>
        <form method="post" asp-controller="Admin" asp-action="Logout">
            <button class="btn btn-outline-danger rounded-pill px-4 fw-bold">
                <i class="bi bi-box-arrow-right me-1"></i> Admin Logout
            </button>
        </form>
    </div>

    <!-- Quick Stats -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 stat-card">
                <small class="text-muted fw-semibold">Total Requests</small>
                <div class="fs-3 fw-bold text-dark">@Model.Count</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 stat-card">
                <small class="text-muted fw-semibold">Pending Approval</small>
                <div class="fs-3 fw-bold text-warning">@pendingCount</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 stat-card">
                <small class="text-muted fw-semibold">Confirmed</small>
                <div class="fs-3 fw-bold text-success">@confirmedCount</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 stat-card">
                <small class="text-muted fw-semibold">Council Status</small>
                <div class="fs-3 fw-bold text-brand"><i class="bi bi-shield-check"></i> Active</div>
            </div>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
            <div class="display-4 text-muted mb-3"><i class="bi bi-inbox"></i></div>
            <h4>No bookings recorded yet</h4>
            <p class="text-muted">New player reservations will appear here automatically.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="text-muted small text-uppercase">
                            <th class="ps-4">Reference</th>
                            <th>Member</th>
                            <th>Facility & Location</th>
                            <th>Date & Time</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Placed At</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-brand">@b.Reference</td>
                                <td>
                                    <div class="fw-bold">@b.MemberName</div>
                                    <small class="text-muted">@b.MemberEmail</small>
                                </td>
                                <td>
                                    <div class="fw-semibold">@b.FacilityName</div>
                                    <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@b.Location</small>
                                </td>
                                <td>
                                    <div class="fw-semibold">@b.BookingDate.ToString("dd MMM yyyy")</div>
                                    <small class="text-muted">@b.StartTime.ToString(@"hh\:mm") – @b.EndTime.ToString(@"hh\:mm")</small>
                                </td>
                                <td class="fw-bold">
                                    @(b.TotalPrice.HasValue ? "£" + b.TotalPrice.Value.ToString("0.00") : "—")
                                </td>
                                <td>
                                    <span class="badge status-@b.Status.ToLower()">@b.Status</span>
                                </td>
                                <td>
                                    <small class="text-muted">@b.CreatedOn.ToString("dd MMM, HH:mm")</small>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1">
                                        @if (b.Status == "Pending")
                                        {
                                            <form class="d-inline" method="post" asp-action="SetStatus" asp-route-id="@b.BookingID" asp-route-status="Confirmed">
                                                <button class="btn btn-sm btn-success rounded-pill px-3 fw-bold">
                                                    <i class="bi bi-check-lg me-1"></i> Confirm
                                                </button>
                                            </form>
                                        }
                                        @if (b.Status != "Cancelled")
                                        {
                                            <form class="d-inline" method="post" asp-action="SetStatus" asp-route-id="@b.BookingID" asp-route-status="Cancelled">
                                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                    Cancel
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>