@model Facility
@{
    ViewData["Title"] = Model.FacilityName;
    var reviews = (List<Review>)ViewBag.Reviews;
    var isMember = Context.Session.GetInt32("MemberID") != null;
    double avg = Model.AvgRating ?? 0;
    string mainImage = FacilityImageHelper.GetFacilityImage(Model.TypeName, Model.FacilityName, Model.FacilityID);
    var gallery = FacilityImageHelper.GetFacilityGallery(Model.TypeName, Model.FacilityName);
    string sportIcon = FacilityImageHelper.GetSportIcon(Model.TypeName);
    var amenities = FacilityImageHelper.GetAmenities(Model.TypeName);
}

<div class="container py-5">
    <!-- Breadcrumb & Back -->
    <div class="mb-3">
        <a class="text-decoration-none text-muted small fw-semibold" asp-controller="Facility" asp-action="Browse">
            <i class="bi bi-arrow-left me-1"></i> Back to All Venues
        </a>
    </div>

    <div class="row g-4">
        <!-- Left Column: Facility Info & Real Photos -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="facility-hero-banner">
                    <img id="mainFacilityImg" src="@mainImage" alt="@Model.FacilityName" 
                         onerror="this.src='https://images.unsplash.com/photo-1517649763962-0c623266ddc0?auto=format&fit=crop&w=1200&q=80'" />
                    <div class="facility-hero-overlay">
                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2 fw-bold mb-2">
                            <i class="bi @sportIcon me-1"></i>@Model.TypeName
                        </span>
                        <h2 class="fw-bold mb-1 text-white">@Model.FacilityName</h2>
                        <p class="mb-0 text-white-50 small">
                            <i class="bi bi-geo-alt-fill text-warning me-1"></i>@Model.Location &nbsp;•&nbsp;
                            <i class="bi bi-people-fill text-info me-1"></i>Capacity: @Model.Capacity players
                        </p>
                    </div>
                </div>
                
                <!-- Gallery Thumbnails -->
                <div class="p-3 bg-white border-bottom">
                    <div class="row g-2">
                        @for (int i = 0; i < gallery.Length; i++)
                        {
                            var img = gallery[i];
                            <div class="col-4">
                                <div class="gallery-thumbnail" onclick="document.getElementById('mainFacilityImg').src='@img'">
                                    <img src="@img" alt="Gallery @i" />
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="card-body p-4">
                    <h5 class="fw-bold mb-2">About this Venue</h5>
                    <p class="text-muted mb-4">@Model.Description</p>

                    <h6 class="fw-bold mb-2">Amenities & Venue Features</h6>
                    <div class="row g-2 mb-4">
                        @foreach (var amenity in amenities)
                        {
                            <div class="col-6 col-md-4">
                                <div class="d-flex align-items-center gap-2 p-2 rounded-3 bg-light border small">
                                    <i class="bi bi-check-circle-fill text-brand"></i>
                                    <span class="fw-semibold">@amenity</span>
                                </div>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ContactPhone))
                    {
                        <div class="p-3 rounded-4 bg-emerald-light d-flex align-items-center gap-3">
                            <div class="icon-circle bg-emerald text-white"><i class="bi bi-telephone-fill"></i></div>
                            <div>
                                <small class="text-muted d-block">Venue Front Desk / Inquiries</small>
                                <strong class="text-brand">@Model.ContactPhone</strong>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column: Booking Box & Reviews -->
        <div class="col-lg-5">
            <!-- Reservation Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <span class="kicker">RESERVATION</span>
                    <h4 class="fw-bold mb-3">Book This Arena</h4>

                    @if (isMember)
                    {
                        <div class="d-flex align-items-baseline gap-2 mb-3">
                            <span class="display-6 fw-bold text-brand">£@Model.HourlyRate.ToString("0.00")</span>
                            <span class="text-muted small">/ hour</span>
                        </div>
                        <ul class="list-unstyled small text-muted d-flex flex-column gap-2 mb-4">
                            <li><i class="bi bi-check2 text-brand me-1"></i> Real-time slot conflict check</li>
                            <li><i class="bi bi-check2 text-brand me-1"></i> Instant PDF receipt with QR entry pass</li>
                            <li><i class="bi bi-check2 text-brand me-1"></i> Free cancellation prior to booking start</li>
                        </ul>
                        <a class="btn btn-brand btn-lg w-100 rounded-pill fw-bold shadow-sm" asp-controller="Booking" asp-action="Book" asp-route-facilityId="@Model.FacilityID">
                            <i class="bi bi-calendar-check me-2"></i>Select Date & Time Slot
                        </a>
                    }
                    else
                    {
                        <div class="alert alert-warning border-0 rounded-4 p-3 mb-3">
                            <i class="bi bi-lock-fill me-1"></i> Hourly rates & booking are exclusive to <strong>verified members</strong>.
                        </div>
                        <p class="text-muted small mb-4">Join our community sports portal for free to view pricing and make instant reservations.</p>
                        <div class="d-flex flex-column gap-2">
                            <a class="btn btn-warning btn-lg rounded-pill fw-bold shadow-sm" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus-fill me-1"></i> Join Free to Book
                            </a>
                            <a class="btn btn-outline-brand rounded-pill" asp-controller="Account" asp-action="Login">
                                Already a Member? Sign In
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Member Reviews Card -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0">Player Reviews</h5>
                        @if (isMember)
                        {
                            <a class="btn btn-sm btn-outline-brand rounded-pill px-3" asp-controller="Review" asp-action="Create" asp-route-facilityId="@Model.FacilityID">
                                <i class="bi bi-pencil me-1"></i> Write Review
                            </a>
                        }
                    </div>

                    @if (reviews.Count == 0)
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-chat-heart display-6 text-muted mb-2 d-block"></i>
                            <p class="text-muted small mb-0">No reviews yet. Be the first player to share your feedback!</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-3 mb-4 p-3 rounded-4 bg-emerald-light">
                            <span class="display-6 fw-bold text-brand mb-0">@avg.ToString("0.0")</span>
                            <div>
                                <div>
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="bi bi-star@(i <= Math.Round(avg) ? "-fill" : "") text-warning"></i>
                                    }
                                </div>
                                <div class="small text-muted fw-semibold">Based on @reviews.Count verified review(s)</div>
                            </div>
                        </div>

                        <div class="d-flex flex-column gap-3">
                            @foreach (var rv in reviews.Take(4))
                            {
                                <div class="border-bottom pb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold small"><i class="bi bi-person-circle text-brand me-1"></i>@rv.MemberName</span>
                                        <span class="small text-muted">@rv.ReviewDate.ToString("dd MMM yyyy")</span>
                                    </div>
                                    <div class="mb-1">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="bi bi-star@(i <= rv.Rating ? "-fill" : "") text-warning small"></i>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(rv.Comments))
                                    {
                                        <p class="text-muted small mb-0">@rv.Comments</p>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>