<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ArenaPulse Community Sports Hub</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg fixed-top app-navbar">
        <div class="container">
            <a class="navbar-brand fw-bold text-white" asp-controller="Home" asp-action="Index">
                <span class="brand-icon"><i class="bi bi-lightning-charge-fill"></i></span>
                <span>Arena<span class="text-warning">Pulse</span></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-lg-1">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")" 
                           asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door me-1 d-lg-none"></i> Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "About" ? "active" : "")" 
                           asp-controller="Home" asp-action="About">
                            <i class="bi bi-info-circle me-1 d-lg-none"></i> About Us
                        </a>
                    </li>
                    @if (Context.Session.GetInt32("MemberID") != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Facility" && ViewContext.RouteData.Values["Action"]?.ToString() == "Search" ? "active" : "")" 
                               asp-controller="Facility" asp-action="Search">
                                <i class="bi bi-search me-1 d-lg-none"></i> Find Facilities
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Booking" && ViewContext.RouteData.Values["Action"]?.ToString() == "MyBookings" ? "active" : "")" 
                               asp-controller="Booking" asp-action="MyBookings">
                                <i class="bi bi-journal-check me-1 d-lg-none"></i> My Bookings
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Review" && ViewContext.RouteData.Values["Action"]?.ToString() == "Create" ? "active" : "")" 
                               asp-controller="Review" asp-action="Create">
                                <i class="bi bi-star me-1 d-lg-none"></i> Write Review
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Facility" && ViewContext.RouteData.Values["Action"]?.ToString() == "Browse" ? "active" : "")" 
                               asp-controller="Facility" asp-action="Browse">
                                <i class="bi bi-compass me-1 d-lg-none"></i> Browse Venues
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Review" ? "active" : "")" 
                               asp-controller="Review" asp-action="Latest">
                                <i class="bi bi-chat-quote me-1 d-lg-none"></i> Reviews
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "Contact" ? "active" : "")" 
                           asp-controller="Home" asp-action="Contact">
                            <i class="bi bi-envelope me-1 d-lg-none"></i> Contact
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav align-items-lg-center gap-2 mt-3 mt-lg-0">
                    @if (Context.Session.GetInt32("MemberID") != null)
                    {
                        <li class="nav-item">
                            <span class="badge bg-white text-dark rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center">
                                <i class="bi bi-person-circle text-brand me-2 fs-6"></i>
                                @Context.Session.GetString("MemberName")
                            </span>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button class="btn btn-sm btn-outline-light rounded-pill px-3" type="submit">
                                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="GuestLogin" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill px-3 w-100 w-lg-auto" title="Instant Guest Demo Login">
                                    <i class="bi bi-lightning-fill me-1"></i> Guest Demo
                                </button>
                            </form>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-sm btn-outline-light rounded-pill px-3 w-100 w-lg-auto" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-sm btn-warning rounded-pill px-4 fw-bold w-100 w-lg-auto shadow-sm" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus-fill me-1"></i> Join Free
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="app-main">
        @if (TempData["Ok"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4 border-0" role="alert">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>@TempData["Ok"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-info alert-dismissible fade show shadow-sm rounded-4 border-0" role="alert">
                    <i class="bi bi-info-circle-fill me-2 fs-5"></i>@TempData["Info"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="app-footer text-white pt-5 pb-4 mt-auto">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center mb-3">
                        <span class="brand-icon"><i class="bi bi-lightning-charge-fill"></i></span>
                        <h5 class="fw-bold mb-0 text-white">Arena<span class="text-warning">Pulse</span></h5>
                    </div>
                    <p class="text-white-50 small mb-3">
                        ArenaPulse is the modern community sports booking gateway. Connecting players, teams, and local families with premium artificial turfs, badminton courts, tennis clubs, and Olympic pools.
                    </p>
                    <div class="d-flex gap-2">
                        <a href="#" class="social-icon-btn"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-icon-btn"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="social-icon-btn"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="social-icon-btn"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-uppercase text-warning fw-bold small mb-3">Navigation</h6>
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
                        <li><a class="footer-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a class="footer-link" asp-controller="Home" asp-action="About">About ArenaPulse</a></li>
                        <li><a class="footer-link" asp-controller="Facility" asp-action="Browse">Browse Venues</a></li>
                        <li><a class="footer-link" asp-controller="Review" asp-action="Latest">Player Reviews</a></li>
                        <li><a class="footer-link" asp-controller="Home" asp-action="Contact">Contact Support</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6 col-6">
                    <h6 class="text-uppercase text-warning fw-bold small mb-3">Player Hub</h6>
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
                        <li><a class="footer-link" asp-controller="Account" asp-action="Register">Free Membership</a></li>
                        <li><a class="footer-link" asp-controller="Account" asp-action="Login">Player Sign In</a></li>
                        <li><a class="footer-link" asp-controller="Admin" asp-action="Login">Council Admin</a></li>
                        <li><span class="text-white-50"><i class="bi bi-shield-check text-warning me-1"></i> 100% Verified Venues</span></li>
                        <li><span class="text-white-50"><i class="bi bi-file-earmark-pdf text-warning me-1"></i> Instant QR Passes</span></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-uppercase text-warning fw-bold small mb-3">Council Office</h6>
                    <p class="text-white-50 small mb-2"><i class="bi bi-geo-alt-fill text-warning me-2"></i>1 Community Way, Civic Center</p>
                    <p class="text-white-50 small mb-2"><i class="bi bi-telephone-fill text-warning me-2"></i>020 7946 0000</p>
                    <p class="text-white-50 small mb-2"><i class="bi bi-envelope-fill text-warning me-2"></i>support@arenapulse.com</p>
                    <p class="text-white-50 small mb-0"><i class="bi bi-clock-fill text-warning me-2"></i>Mon–Sun: 7:00 AM – 10:00 PM</p>
                </div>
            </div>
            <hr class="border-secondary opacity-25" />
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 small text-white-50">
                <p class="mb-0">© @DateTime.Now.Year ArenaPulse Sports Council — All rights reserved.</p>
                <p class="mb-0">Designed for Champions & Community Athletes</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>