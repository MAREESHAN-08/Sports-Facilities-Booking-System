@model List<Booking>
@{
    ViewData["Title"] = "My Bookings";
    int confirmedCount = Model.Count(b => b.Status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase));
    int pendingCount = Model.Count(b => b.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase));
}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="kicker">MEMBER DASHBOARD</span>
            <h1 class="display-6 fw-bold mb-1">My Venue Reservations</h1>
            <p class="text-muted small mb-0">Manage your upcoming and past bookings, download digital QR receipts, and write reviews.</p>
        </div>
        <a class="btn btn-brand rounded-pill px-4 fw-bold shadow-sm" asp-controller="Facility" asp-action="Search">
            <i class="bi bi-plus-circle me-1"></i> Book New Facility
        </a>
    </div>

    <!-- Summary Stats Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 stat-card">
                <small class="text-muted fw-semibold">Total Reservations</small>
                <div class="fs-3 fw-bold text-dark">@Model.Count</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 stat-card">
                <small class="text-muted fw-semibold">Confirmed</small>
                <div class="fs-3 fw-bold text-success">@confirmedCount</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 stat-card">
                <small class="text-muted fw-semibold">Pending Review</small>
                <div class="fs-3 fw-bold text-warning">@pendingCount</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 stat-card">
                <small class="text-muted fw-semibold">Digital PDF Passes</small>
                <div class="fs-3 fw-bold text-brand"><i class="bi bi-qr-code"></i> Instant</div>
            </div>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 text-center p-5">
            <div class="display-4 text-muted mb-3"><i class="bi bi-calendar-check"></i></div>
            <h4 class="fw-bold">No reservations booked yet</h4>
            <p class="text-muted mb-4">Find a turf, tennis court, badminton hall or pool and book your first slot!</p>
            <a class="btn btn-brand rounded-pill px-4 mx-auto fw-bold" asp-controller="Facility" asp-action="Search">
                <i class="bi bi-search me-1"></i> Find Available Venues
            </a>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="text-muted small text-uppercase">
                            <th class="ps-4">Reference</th>
                            <th>Venue & Sport</th>
                            <th>Date</th>
                            <th>Time Window</th>
                            <th>Total Price</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-brand">
                                    <span class="badge bg-emerald-light text-brand rounded-pill px-2 py-1">@b.Reference</span>
                                </td>
                                <td>
                                    <div class="fw-bold">@b.FacilityName</div>
                                    <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@b.Location</small>
                                </td>
                                <td>
                                    <div class="fw-semibold">@b.BookingDate.ToString("ddd, dd MMM yyyy")</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-clock me-1 text-muted"></i>@b.StartTime.ToString(@"hh\:mm") – @b.EndTime.ToString(@"hh\:mm")
                                    </span>
                                </td>
                                <td class="fw-bold text-dark">
                                    @(b.TotalPrice.HasValue ? "£" + b.TotalPrice.Value.ToString("0.00") : "—")
                                </td>
                                <td>
                                    <span class="badge status-@b.Status.ToLower()">@b.Status</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1 flex-wrap justify-content-end">
                                        <a class="btn btn-sm btn-outline-brand rounded-pill px-3" asp-action="Receipt" asp-route-id="@b.BookingID" title="Download Official PDF Receipt">
                                            <i class="bi bi-file-earmark-pdf-fill me-1"></i> Receipt
                                        </a>
                                        @if (b.Status != "Cancelled")
                                        {
                                            <form class="d-inline" method="post" asp-action="Cancel" asp-route-id="@b.BookingID"
                                                  onsubmit="return confirm('Are you sure you want to cancel booking @b.Reference?');">
                                                <button class="btn btn-sm btn-outline-danger rounded-pill px-2" title="Cancel Booking">
                                                    Cancel
                                                </button>
                                            </form>
                                        }
                                        <a class="btn btn-sm btn-light rounded-pill px-2" asp-controller="Review" asp-action="Create" asp-route-facilityId="@b.FacilityID" title="Leave Review">
                                            <i class="bi bi-star"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>