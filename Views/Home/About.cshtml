@{
    ViewData["Title"] = "About Us — ArenaPulse";
    var stats = (HomeStats)ViewBag.Stats;
    var types = (List<FacilityType>)ViewBag.Types;
}

<!-- Hero Section -->
<section class="about-hero position-relative text-white overflow-hidden d-flex align-items-center">
    <div class="about-hero-overlay"></div>
    <div class="container position-relative py-5">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge rounded-pill bg-warning text-dark mb-3 px-3 py-2 fw-bold">
                    <i class="bi bi-shield-check me-1"></i> MUNICIPAL SPORTS COUNCIL INITIATIVE
                </span>
                <h1 class="display-4 fw-extrabold mb-3">
                    Empowering Our Community Through <span class="text-warning">Sports & Active Living</span>
                </h1>
                <p class="lead text-light opacity-90 mb-4">
                    <strong>ArenaPulse</strong> connects athletes, casual players, schools, and local clubs with world-class community sports facilities. From floodlit turf pitches to Olympic pools and indoor courts — we make booking simple, instant, and accessible to everyone.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a class="btn btn-warning btn-lg rounded-pill px-4 fw-bold shadow-sm" asp-controller="Facility" asp-action="Browse">
                        <i class="bi bi-compass me-2"></i>Explore Venues
                    </a>
                    <a class="btn btn-outline-light btn-lg rounded-pill px-4 shadow-sm" asp-controller="Home" asp-action="Contact">
                        <i class="bi bi-chat-dots me-2"></i>Contact Council
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Impact Stats Section -->
<section class="py-5 stats-banner shadow-sm">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-6 col-md-3">
                <div class="stat-card p-3 rounded-4">
                    <div class="display-5 fw-bold text-brand mb-1">@(stats?.Facilities ?? 12)+</div>
                    <div class="text-muted fw-semibold small text-uppercase tracking-wider">Premium Facilities</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card p-3 rounded-4">
                    <div class="display-5 fw-bold text-accent mb-1">@(stats?.Members ?? 250)+</div>
                    <div class="text-muted fw-semibold small text-uppercase tracking-wider">Active Members</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card p-3 rounded-4">
                    <div class="display-5 fw-bold text-brand mb-1">@(stats?.Bookings ?? 800)+</div>
                    <div class="text-muted fw-semibold small text-uppercase tracking-wider">Bookings Completed</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card p-3 rounded-4">
                    <div class="display-5 fw-bold text-accent mb-1">99.4%</div>
                    <div class="text-muted fw-semibold small text-uppercase tracking-wider">Satisfaction Rate</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Mission & Vision -->
<section class="py-5 bg-white">
    <div class="container py-lg-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="position-relative">
                    <img src="https://images.unsplash.com/photo-1526676037777-05a232554f77?auto=format&fit=crop&w=1000&q=80" 
                         alt="Community Sports Activity" class="img-fluid rounded-4 shadow-lg w-100" style="min-height:380px; object-fit:cover;" />
                    <div class="floating-badge d-none d-sm-flex align-items-center gap-3 bg-white p-3 rounded-4 shadow-lg position-absolute bottom-0 start-0 m-4">
                        <div class="badge-icon bg-emerald text-white rounded-circle p-3 d-flex align-items-center justify-content-center">
                            <i class="bi bi-trophy fs-4"></i>
                        </div>
                        <div>
                            <div class="fw-bold mb-0 text-dark">Award-Winning Council</div>
                            <small class="text-muted">Best Community Wellness Initiative</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <span class="kicker">OUR PURPOSE & VISION</span>
                <h2 class="display-6 fw-bold mb-3">Making Every Sport Accessible In Every Neighborhood</h2>
                <p class="text-muted lead fs-6 mb-4">
                    We believe that regular sports and recreation should not be a luxury. The Municipal Sports Council founded <strong>ArenaPulse</strong> to eradicate empty sports halls and cumbersome paper booking systems.
                </p>
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex align-items-start gap-3">
                        <div class="icon-circle bg-emerald-light text-brand"><i class="bi bi-calendar-check-fill"></i></div>
                        <div>
                            <h6 class="fw-bold mb-1">Real-Time Slot Booking</h6>
                            <p class="text-muted small mb-0">Live conflict detection prevents double booking and ensures your requested slot is reserved instantly.</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3">
                        <div class="icon-circle bg-emerald-light text-brand"><i class="bi bi-tags-fill"></i></div>
                        <div>
                            <h6 class="fw-bold mb-1">Fair & Subsidized Community Rates</h6>
                            <p class="text-muted small mb-0">Transparent hourly pricing with council subsidies so families, youth teams, and clubs can play affordably.</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3">
                        <div class="icon-circle bg-emerald-light text-brand"><i class="bi bi-qr-code-scan"></i></div>
                        <div>
                            <h6 class="fw-bold mb-1">Digital QR Passes & PDF Invoices</h6>
                            <p class="text-muted small mb-0">Automatic instant PDF generation with secure verification codes for venue access.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Visual Facility Showcase / Venues -->
<section class="py-5 app-bg-light">
    <div class="container py-lg-4">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="kicker">PREMIUM VENUES</span>
            <h2 class="fw-bold">Designed for Champions of All Levels</h2>
            <p class="text-muted">Every court, pitch, and pool is maintained to national standards with LED floodlights, professional surfaces, and full safety certifications.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="showcase-card rounded-4 overflow-hidden shadow-sm position-relative">
                    <img src="https://images.unsplash.com/photo-1529900248461-9056a3bf663d?auto=format&fit=crop&w=700&q=80" 
                         class="w-100 showcase-img" alt="Football & Turf" />
                    <div class="showcase-overlay p-3 text-white">
                        <span class="badge bg-warning text-dark mb-1">Outdoor & Indoor</span>
                        <h5 class="fw-bold mb-0">Football & 5G Turf</h5>
                        <p class="small text-white-50 mb-0">FIFA-grade 3G/5G astro with LED floodlights</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="showcase-card rounded-4 overflow-hidden shadow-sm position-relative">
                    <img src="https://images.unsplash.com/photo-1626224583764-f87db24ac4ea?auto=format&fit=crop&w=700&q=80" 
                         class="w-100 showcase-img" alt="Badminton Arena" />
                    <div class="showcase-overlay p-3 text-white">
                        <span class="badge bg-success mb-1">Pro Flooring</span>
                        <h5 class="fw-bold mb-0">Badminton Arenas</h5>
                        <p class="small text-white-50 mb-0">BWF synthetic cushioned mats & shadow-free lights</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="showcase-card rounded-4 overflow-hidden shadow-sm position-relative">
                    <img src="https://images.unsplash.com/photo-1595435934249-5df7ed86e1c0?auto=format&fit=crop&w=700&q=80" 
                         class="w-100 showcase-img" alt="Tennis Courts" />
                    <div class="showcase-overlay p-3 text-white">
                        <span class="badge bg-info text-dark mb-1">Clay & Hard</span>
                        <h5 class="fw-bold mb-0">Tennis Courts</h5>
                        <p class="small text-white-50 mb-0">All-weather acrylic and classic clay options</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="showcase-card rounded-4 overflow-hidden shadow-sm position-relative">
                    <img src="https://images.unsplash.com/photo-1576013551627-0cc20b96c2a7?auto=format&fit=crop&w=700&q=80" 
                         class="w-100 showcase-img" alt="Swimming Pool" />
                    <div class="showcase-overlay p-3 text-white">
                        <span class="badge bg-primary mb-1">Heated Pool</span>
                        <h5 class="fw-bold mb-0">Olympic Swimming</h5>
                        <p class="small text-white-50 mb-0">25m & 50m temperature-controlled lap lanes</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Our Leadership & Team -->
<section class="py-5 bg-white">
    <div class="container py-lg-4">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="kicker">LEADERSHIP & OPERATIONS</span>
            <h2 class="fw-bold">Meet the ArenaPulse Sports Team</h2>
            <p class="text-muted">Dedicated professionals ensuring our community venues are safe, well-equipped, and smoothly run seven days a week.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 team-card">
                    <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=400&q=80" 
                         class="rounded-circle mx-auto mb-3 team-avatar shadow" alt="Sarah Jenkins" />
                    <h5 class="fw-bold mb-1">Dr. Sarah Jenkins</h5>
                    <p class="text-brand fw-semibold small mb-2">Director of Sports & Recreation</p>
                    <p class="text-muted small mb-0">Championing active living policies and expanding municipal fitness access across all borough districts.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 team-card">
                    <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=400&q=80" 
                         class="rounded-circle mx-auto mb-3 team-avatar shadow" alt="Marcus Thorne" />
                    <h5 class="fw-bold mb-1">Marcus Thorne</h5>
                    <p class="text-brand fw-semibold small mb-2">Head of Venue Operations</p>
                    <p class="text-muted small mb-0">Oversees pitch surface maintenance, safety certifications, floodlights, and automated access systems.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 team-card">
                    <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=400&q=80" 
                         class="rounded-circle mx-auto mb-3 team-avatar shadow" alt="Elena Rodriguez" />
                    <h5 class="fw-bold mb-1">Elena Rodriguez</h5>
                    <p class="text-brand fw-semibold small mb-2">Community Engagement Lead</p>
                    <p class="text-muted small mb-0">Coordinates youth tournament bookings, school league partnerships, and senior wellness sessions.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Frequently Asked Questions -->
<section class="py-5 app-bg-light">
    <div class="container py-lg-4">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="kicker">GOT QUESTIONS?</span>
            <h2 class="fw-bold">Frequently Asked Questions</h2>
            <p class="text-muted">Everything you need to know about booking, cancellation, and venue guidelines.</p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="accordion custom-accordion shadow-sm rounded-4 overflow-hidden" id="faqAccordion">
                    <div class="accordion-item border-0 border-bottom">
                        <h2 class="accordion-header" id="faq1">
                            <button class="accordion-button fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapse1" aria-expanded="true" aria-controls="collapse1">
                                <i class="bi bi-question-circle text-brand me-2"></i> How do I book a sports court or pitch?
                            </button>
                        </h2>
                        <div id="collapse1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-muted">
                                Simply register for a free account or continue with 1-click Guest Access, browse or search for your desired facility by date and time, and click <strong>Book</strong>. Once submitted, your slot is instantly reserved and a downloadable PDF receipt with QR pass is generated.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item border-0 border-bottom">
                        <h2 class="accordion-header" id="faq2">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapse2" aria-expanded="false" aria-controls="collapse2">
                                <i class="bi bi-question-circle text-brand me-2"></i> Can I cancel or reschedule my booking?
                            </button>
                        </h2>
                        <div id="collapse2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-muted">
                                Yes! You can view and manage all your active reservations from the <strong>My Bookings</strong> section. You can cancel any booking before the session starts with one click.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item border-0 border-bottom">
                        <h2 class="accordion-header" id="faq3">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapse3" aria-expanded="false" aria-controls="collapse3">
                                <i class="bi bi-question-circle text-brand me-2"></i> Are equipment rentals and lighting included in the hourly fee?
                            </button>
                        </h2>
                        <div id="collapse3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-muted">
                                LED floodlights and court netting are fully included in the hourly rate. Rackets, balls, and specialized gear can be rented at the reception on-site at nominal council rates.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item border-0">
                        <h2 class="accordion-header" id="faq4">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapse4" aria-expanded="false" aria-controls="collapse4">
                                <i class="bi bi-question-circle text-brand me-2"></i> Can guests test booking or check availability before joining?
                            </button>
                        </h2>
                        <div id="collapse4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-muted">
                                Absolutely. Guests can freely use the <strong>Browse Venues</strong> page or use the <strong>1-Click Guest Demo Login</strong> to test the full booking flow right away.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call To Action -->
<section class="py-5 cta-banner text-white text-center position-relative overflow-hidden">
    <div class="container position-relative py-4">
        <h2 class="display-6 fw-bold mb-3">Ready to Step Onto the Field?</h2>
        <p class="lead text-light opacity-90 max-w-700 mx-auto mb-4">
            Join thousands of local players making sports a part of their daily routine with ArenaPulse. Create your free account in under 60 seconds.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a class="btn btn-warning btn-lg rounded-pill px-5 fw-bold shadow-lg" asp-controller="Account" asp-action="Register">
                <i class="bi bi-person-plus-fill me-2"></i>Join Free Now
            </a>
            <a class="btn btn-outline-light btn-lg rounded-pill px-5 shadow" asp-controller="Facility" asp-action="Browse">
                <i class="bi bi-compass me-2"></i>Browse All Venues
            </a>
        </div>
    </div>
</section>
