@{
    ViewData["Title"] = "Home — ArenaPulse";
    var featured = (List<Facility>)ViewBag.Featured;
    var latestReviews = (List<Review>)ViewBag.LatestReviews;
    var stats = (HomeStats)ViewBag.Stats;
    var isMember = Context.Session.GetInt32("MemberID") != null;
    var memberName = Context.Session.GetString("MemberName") ?? "Player";
}

<!-- Hero Section -->
<section class="hero d-flex align-items-center">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7 text-white">
                <div class="hero-pulse-badge mb-3">
                    <span class="pulse-dot"></span>
                    <span>Live Booking & Instant Verification</span>
                </div>
                <h1 class="display-4 fw-extrabold mb-3">
                    Book your favourite <span class="text-warning">sports venue</span> in seconds.
                </h1>
                <p class="lead text-light opacity-90 mb-4">
                    High-grade football turfs, indoor badminton courts, tennis clubs, and Olympic swimming pools across the community. Search live availability, reserve conflict-free slots, and get an instant PDF pass with <strong>ArenaPulse</strong>.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    @if (isMember)
                    {
                        <a class="btn btn-warning btn-lg rounded-pill px-4 fw-bold shadow-sm" asp-controller="Facility" asp-action="Search">
                            <i class="bi bi-search me-2"></i>Find a Facility
                        </a>
                        <a class="btn btn-outline-light btn-lg rounded-pill px-4 shadow-sm" asp-controller="Booking" asp-action="MyBookings">
                            <i class="bi bi-journal-check me-2"></i>My Bookings
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-warning btn-lg rounded-pill px-4 fw-bold shadow-sm" asp-controller="Account" asp-action="Register">
                            <i class="bi bi-person-plus-fill me-2"></i>Become a Member
                        </a>
                        <a class="btn btn-outline-light btn-lg rounded-pill px-4 shadow-sm" asp-controller="Facility" asp-action="Browse">
                            <i class="bi bi-compass me-2"></i>Browse Venues
                        </a>
                    }
                </div>
                <div class="d-flex gap-4 mt-5 flex-wrap">
                    <div>
                        <div class="hero-stat">@(stats?.Facilities ?? 12)</div>
                        <div class="text-light opacity-75 small">Sports Facilities</div>
                    </div>
                    <div>
                        <div class="hero-stat">@(stats?.Members ?? 250)</div>
                        <div class="text-light opacity-75 small">Active Members</div>
                    </div>
                    <div>
                        <div class="hero-stat">@(stats?.Bookings ?? 800)</div>
                        <div class="text-light opacity-75 small">Bookings Completed</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                @if (isMember)
                {
                    <!-- Member Welcome & Quick Actions Dashboard Card (Shown ONLY when Logged In) -->
                    <div class="card hero-card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                        <div class="p-4 bg-emerald text-white">
                            <div class="d-flex align-items-center gap-3">
                                <div class="brand-icon mb-0 bg-warning text-dark"><i class="bi bi-person-fill fs-4"></i></div>
                                <div>
                                    <h5 class="fw-bold mb-0 text-white">Welcome, @memberName!</h5>
                                    <span class="badge bg-white text-dark rounded-pill px-2 py-1 small fw-semibold mt-1">
                                        <i class="bi bi-check-circle-fill text-success me-1"></i> Active Member Account
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="card-body p-4">
                            <div class="mb-3">
                                <a class="btn btn-brand btn-lg w-100 rounded-pill fw-bold shadow-sm" asp-controller="Facility" asp-action="Search">
                                    <i class="bi bi-search me-2"></i>Find & Book Venue Slot
                                </a>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <a asp-controller="Booking" asp-action="MyBookings" class="card text-center p-3 rounded-4 text-decoration-none h-100 feature-card bg-light border-0">
                                        <i class="bi bi-journal-check text-brand fs-3 mb-1"></i>
                                        <span class="fw-bold text-dark small d-block">My Bookings</span>
                                        <span class="text-muted" style="font-size:0.75rem;">QR Passes & Receipts</span>
                                    </a>
                                </div>
                                <div class="col-6">
                                    <a asp-controller="Review" asp-action="Create" class="card text-center p-3 rounded-4 text-decoration-none h-100 feature-card bg-light border-0">
                                        <i class="bi bi-star-fill text-warning fs-3 mb-1"></i>
                                        <span class="fw-bold text-dark small d-block">Write Review</span>
                                        <span class="text-muted" style="font-size:0.75rem;">Share Experience</span>
                                    </a>
                                </div>
                            </div>

                            <div class="p-3 bg-emerald-light rounded-4 d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <small class="text-muted d-block fw-semibold">Community Venues</small>
                                    <strong class="text-dark small">Explore All Arenas & Courts</strong>
                                </div>
                                <a asp-controller="Facility" asp-action="Browse" class="btn btn-sm btn-outline-brand rounded-pill px-3 fw-bold">
                                    Browse <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>

                            <div class="text-center pt-2 border-top">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-link text-danger text-decoration-none">
                                        <i class="bi bi-box-arrow-right me-1"></i> Logout from @memberName
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Sign In / Guest / Register Tabs (Shown ONLY when Guest / Logged Out) -->
                    <div class="card hero-card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                        <div class="card-header bg-white border-0 pt-4 text-center">
                            <ul class="nav nav-pills justify-content-center gap-2" role="tablist">
                                <li class="nav-item">
                                    <button class="nav-link active rounded-pill px-3 fw-semibold" data-bs-toggle="pill" data-bs-target="#tabLogin" type="button">
                                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link rounded-pill px-3 fw-semibold" data-bs-toggle="pill" data-bs-target="#tabGuest" type="button">
                                        <i class="bi bi-lightning-fill me-1 text-warning"></i> Guest Access
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link rounded-pill px-3 fw-semibold" data-bs-toggle="pill" data-bs-target="#tabRegister" type="button">
                                        <i class="bi bi-person-plus me-1"></i> Join
                                    </button>
                                </li>
                            </ul>
                        </div>
                        <div class="card-body p-4">
                            <div class="tab-content">
                                <!-- Tab 1: Member Sign In -->
                                <div class="tab-pane fade show active" id="tabLogin">
                                    <form asp-controller="Account" asp-action="Login" method="post">
                                        <div class="mb-3">
                                            <label class="form-label small fw-semibold">Email Address</label>
                                            <input class="form-control" type="email" name="Email" placeholder="your@email.com" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label small fw-semibold">Password</label>
                                            <input class="form-control" type="password" name="Password" placeholder="••••••••" required />
                                        </div>
                                        <button class="btn btn-brand btn-lg w-100 rounded-pill fw-bold">
                                            Sign In <i class="bi bi-arrow-right ms-1"></i>
                                        </button>
                                        <p class="text-center text-muted small mt-3 mb-0">
                                            New player? Try the <strong>Guest Access</strong> or <strong>Join</strong> tabs.
                                        </p>
                                    </form>
                                </div>

                                <!-- Tab 2: 1-Click Guest Login -->
                                <div class="tab-pane fade text-center" id="tabGuest">
                                    <div class="icon-circle bg-emerald-light text-brand mx-auto mb-3">
                                        <i class="bi bi-lightning-charge-fill fs-4 text-warning"></i>
                                    </div>
                                    <h5 class="fw-bold mb-1">Instant Guest Member Mode</h5>
                                    <p class="text-muted small mb-3">
                                        Explore all features, test real-time booking, and view member rates with 1-click without creating a password.
                                    </p>
                                    <form asp-controller="Account" asp-action="GuestLogin" method="post">
                                        <button class="btn btn-warning btn-lg w-100 rounded-pill fw-bold shadow-sm">
                                            <i class="bi bi-play-circle-fill me-1"></i> Continue as Guest Player
                                        </button>
                                    </form>
                                </div>

                                <!-- Tab 3: Register -->
                                <div class="tab-pane fade text-center" id="tabRegister">
                                    <div class="icon-circle bg-emerald-light text-brand mx-auto mb-3">
                                        <i class="bi bi-trophy-fill fs-4"></i>
                                    </div>
                                    <h5 class="fw-bold mb-2">Create Your Free Account</h5>
                                    <p class="text-muted small mb-4">
                                        Registering takes under a minute. Choose your favourite sports and unlock direct hourly bookings.
                                    </p>
                                    <a class="btn btn-brand btn-lg w-100 rounded-pill fw-bold" asp-controller="Account" asp-action="Register">
                                        Get Started Now <i class="bi bi-chevron-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- Popular Sports Categories Quick Strip -->
<section class="py-4 bg-white border-bottom">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <span class="kicker mb-0">EXPLORE POPULAR SPORTS</span>
            <a class="text-brand text-decoration-none small fw-bold" asp-controller="Facility" asp-action="Browse">
                View All Categories <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="row g-3">
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Facility" asp-action="Browse" class="card text-center p-3 rounded-4 text-decoration-none h-100 feature-card">
                    <div class="feature-icon mb-2 text-brand"><i class="bi bi-globe-americas"></i></div>
                    <span class="fw-bold text-dark small">Football / Turf</span>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Facility" asp-action="Browse" class="card text-center p-3 rounded-4 text-decoration-none h-100 feature-card">
                    <div class="feature-icon mb-2 text-brand"><i class="bi bi-feather"></i></div>
                    <span class="fw-bold text-dark small">Badminton</span>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Facility" asp-action="Browse" class="card text-center p-3 rounded-4 text-decoration-none h-100 feature-card">
                    <div class="feature-icon mb-2 text-brand"><i class="bi bi-dribbble"></i></div>
                    <span class="fw-bold text-dark small">Tennis</span>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Facility" asp-action="Browse" class="card text-center p-3 rounded-4 text-decoration-none h-100 feature-card">
                    <div class="feature-icon mb-2 text-brand"><i class="bi bi-water"></i></div>
                    <span class="fw-bold text-dark small">Swimming</span>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Facility" asp-action="Browse" class="card text-center p-3 rounded-4 text-decoration-none h-100 feature-card">
                    <div class="feature-icon mb-2 text-brand"><i class="bi bi-circle"></i></div>
                    <span class="fw-bold text-dark small">Basketball</span>
                </a>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Facility" asp-action="Browse" class="card text-center p-3 rounded-4 text-decoration-none h-100 feature-card">
                    <div class="feature-icon mb-2 text-brand"><i class="bi bi-heart-pulse-fill"></i></div>
                    <span class="fw-bold text-dark small">Gym & Fitness</span>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Why Book With ArenaPulse -->
<section class="py-5 bg-white">
    <div class="container py-lg-3">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="kicker">WHY CHOOSE ARENAPULSE</span>
            <h2 class="fw-bold">Everything You Need To Get Moving</h2>
            <p class="text-muted">Designed by the Municipal Sports Council for athletes, teams, and local families.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 rounded-4 feature-card p-4 text-center">
                    <div class="feature-icon mb-3"><i class="bi bi-lightning-charge-fill"></i></div>
                    <h5 class="fw-bold mb-2">Instant Conflict-Free Search</h5>
                    <p class="text-muted small mb-0">Filter by sport, location, and exact time slot. Live database queries prevent any double bookings.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 rounded-4 feature-card p-4 text-center">
                    <div class="feature-icon mb-3"><i class="bi bi-file-earmark-pdf-fill"></i></div>
                    <h5 class="fw-bold mb-2">Instant PDF Pass & Receipts</h5>
                    <p class="text-muted small mb-0">Every reservation generates a verified PDF receipt with digital QR pass for fast check-in at reception.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 rounded-4 feature-card p-4 text-center">
                    <div class="feature-icon mb-3"><i class="bi bi-star-fill"></i></div>
                    <h5 class="fw-bold mb-2">Verified Member Reviews</h5>
                    <p class="text-muted small mb-0">Read genuine feedback from fellow players about lighting, surface quality, and staff friendliness.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Facilities -->
<section class="py-5 app-bg-light">
    <div class="container py-lg-3">
        <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-3">
            <div>
                <span class="kicker">COMMUNITY FAVORITES</span>
                <h2 class="fw-bold mb-0">Featured Venues</h2>
            </div>
            <a class="btn btn-outline-brand rounded-pill px-4" asp-controller="Facility" asp-action="Browse">
                Browse All Venues <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="row g-4">
            @foreach (var f in featured)
            {
                <partial name="_FacilityCard" model="f" />
            }
        </div>
    </div>
</section>

<!-- Member Reviews -->
<section class="py-5 bg-white">
    <div class="container py-lg-3">
        <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-3">
            <div>
                <span class="kicker">COMMUNITY VOICES</span>
                <h2 class="fw-bold mb-0">What Our Players Say</h2>
            </div>
            <a class="btn btn-outline-brand rounded-pill px-4" asp-controller="Review" asp-action="Latest">
                All Reviews <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="row g-4">
            @foreach (var r in latestReviews)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 p-4 feature-card">
                        <div class="d-flex align-items-center gap-1 mb-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="bi bi-star@(i <= r.Rating ? "-fill" : "") text-warning"></i>
                            }
                        </div>
                        <p class="text-muted fst-italic mb-4 flex-grow-1">
                            "@(string.IsNullOrEmpty(r.Comments) ? "Great facility, very well maintained!" : r.Comments)"
                        </p>
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top small">
                            <span class="fw-bold"><i class="bi bi-person-circle text-brand me-1"></i>@r.MemberName</span>
                            <a asp-controller="Review" asp-action="Facility" asp-route-id="@r.FacilityID" class="text-brand text-decoration-none fw-semibold">
                                @r.FacilityName
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>