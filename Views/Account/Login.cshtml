@model LoginViewModel
@{
    ViewData["Title"] = "Sign In — ArenaPulse";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="p-4 bg-emerald text-white text-center">
                    <div class="brand-icon mx-auto mb-2"><i class="bi bi-lightning-charge-fill fs-5"></i></div>
                    <h3 class="fw-bold mb-1 text-white">Welcome to ArenaPulse</h3>
                    <p class="small text-white-50 mb-0">Sign in to book sports facilities & access member rates</p>
                </div>
                <div class="card-body p-4 p-md-5 bg-white">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-4 shadow-sm mb-4"></div>
                    
                    <!-- Quick 1-Click Guest Login -->
                    <div class="p-3 mb-4 rounded-4 bg-emerald-light border border-emerald text-center">
                        <div class="small fw-bold text-dark mb-1">⚡ Quick Demo & Guest Access</div>
                        <p class="small text-muted mb-2">Want to test booking right away without signing up?</p>
                        <form asp-controller="Account" asp-action="GuestLogin" method="post">
                            <button type="submit" class="btn btn-brand w-100 rounded-pill fw-bold shadow-sm">
                                <i class="bi bi-person-check-fill me-1"></i> Continue as Guest Member
                            </button>
                        </form>
                    </div>

                    <div class="d-flex align-items-center my-3">
                        <hr class="flex-grow-1" />
                        <span class="px-2 small text-muted text-uppercase fw-semibold">Or Member Sign In</span>
                        <hr class="flex-grow-1" />
                    </div>

                    <form asp-controller="Account" asp-action="Login" method="post">
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label small fw-semibold text-muted">Email Address</label>
                            <input asp-for="Email" class="form-control form-control-lg" placeholder="your@email.com" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Password" class="form-label small fw-semibold text-muted">Password</label>
                            <input asp-for="Password" class="form-control form-control-lg" placeholder="••••••••" required />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <button class="btn btn-warning btn-lg w-100 rounded-pill fw-bold shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In with Email
                        </button>
                    </form>
                    <div class="text-center mt-4 pt-3 border-top">
                        <p class="text-muted small mb-0">
                            Don't have an account yet? 
                            <a asp-controller="Account" asp-action="Register" class="text-brand fw-bold text-decoration-none">
                                Join Free Here
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}