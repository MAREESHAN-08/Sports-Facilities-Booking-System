@model RegisterViewModel
@{
    ViewData["Title"] = "Join Free — ArenaPulse";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="p-4 bg-emerald text-white text-center">
                    <div class="brand-icon mx-auto mb-2"><i class="bi bi-person-plus-fill fs-5"></i></div>
                    <h2 class="fw-bold mb-1 text-white">Join ArenaPulse Free</h2>
                    <p class="small text-white-50 mb-0">Create your community player account to unlock member rates and book sports venues instantly</p>
                </div>
                <div class="card-body p-4 p-md-5 bg-white">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-4 shadow-sm mb-4"></div>
                    <form asp-controller="Account" asp-action="Register" method="post">
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="FullName" class="form-label small fw-semibold text-muted">Full Name *</label>
                                <input asp-for="FullName" class="form-control" placeholder="e.g. John Doe" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="Email" class="form-label small fw-semibold text-muted">Email Address *</label>
                                <input asp-for="Email" class="form-control" placeholder="your@email.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="Password" class="form-label small fw-semibold text-muted">Password *</label>
                                <input asp-for="Password" class="form-control" placeholder="••••••••" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-muted">Confirm Password *</label>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="Phone" class="form-label small fw-semibold text-muted">Phone Number</label>
                                <input asp-for="Phone" class="form-control" placeholder="e.g. 07123 456789" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="Address" class="form-label small fw-semibold text-muted">Address / Area</label>
                                <input asp-for="Address" class="form-control" placeholder="e.g. High Street, London" />
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                            <div class="col-12 pt-2">
                                <label class="form-label fw-bold text-dark">Preferred Sports & Activities</label>
                                <p class="text-muted small mb-2">Select the sports you are interested in playing to personalize your venue search.</p>
                                <div class="row g-2">
                                    @foreach (var s in (List<Sport>)ViewBag.Sports)
                                    {
                                        <div class="col-6 col-md-4">
                                            <div class="form-check sport-check d-flex align-items-center gap-2">
                                                <input class="form-check-input mt-0" type="checkbox" name="SelectedSportIds"
                                                       value="@s.SportID" id="sp@s.SportID" />
                                                <label class="form-check-label small fw-semibold flex-grow-1" for="sp@s.SportID">
                                                    @s.SportName
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <button class="btn btn-brand btn-lg rounded-pill w-100 mt-4 fw-bold shadow-sm">
                            <i class="bi bi-check2-circle me-2"></i>Create Free Account
                        </button>
                    </form>
                    <div class="text-center mt-4 pt-3 border-top">
                        <p class="text-muted small mb-0">
                            Already registered? 
                            <a asp-controller="Account" asp-action="Login" class="text-brand fw-bold text-decoration-none">
                                Sign In Here
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}