@{
    ViewData["Title"] = "Community Reviews";
    var reviews = (List<Review>)ViewBag.Reviews;
}
<div class="container py-5">
    <div class="mb-4">
        <span class="kicker">COMMUNITY FEEDBACK</span>
        <h1 class="display-6 fw-bold mb-1">What Players Say About Our Venues</h1>
        <p class="text-muted lead fs-6">Genuine reviews submitted by registered members after their match sessions.</p>
    </div>

    @if (reviews.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
            <div class="display-4 text-muted mb-3"><i class="bi bi-chat-heart"></i></div>
            <h4>No reviews published yet</h4>
            <p class="text-muted">Book a venue and be the first to share your experience!</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var r in reviews)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 p-4 feature-card d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center gap-1">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi bi-star@(i <= r.Rating ? "-fill" : "") text-warning"></i>
                                }
                            </div>
                            <span class="small text-muted">@r.ReviewDate.ToString("dd MMM yyyy")</span>
                        </div>
                        <p class="text-muted fst-italic my-3 flex-grow-1">
                            "@(string.IsNullOrEmpty(r.Comments) ? "Great sports venue, well maintained and clean." : r.Comments)"
                        </p>
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top small">
                            <span class="fw-bold"><i class="bi bi-person-circle text-brand me-1"></i>@r.MemberName</span>
                            <a asp-controller="Review" asp-action="Facility" asp-route-id="@r.FacilityID" class="text-brand text-decoration-none fw-semibold">
                                @r.FacilityName <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>